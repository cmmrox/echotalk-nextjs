# Copy to .env.local and replace values locally. Never commit real credentials.

# Current Google Speech-to-Text and Text-to-Speech adapter credentials.
ECHOTALK_GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Current language routes. Production promotion requires measured evaluation.
ECHOTALK_LANGUAGES=en-US,si-LK
ECHOTALK_STT_MODEL=latest_short
ECHOTALK_STT_LOCATION=global

# Current conversation-model adapter.
OPENAI_API_KEY=replace-locally
OPENAI_MODEL=gpt-4.1-mini

# Browser recording and optional local FFmpeg override.
NEXT_PUBLIC_ECHOTALK_MAX_RECORD_SECONDS=60
# FFMPEG_PATH=/absolute/path/to/ffmpeg
