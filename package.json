{
  "name": "echotalk-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "agents:generate": "node scripts/governance/generate-agent-adapters.mjs",
    "agents:generate:check": "node scripts/governance/generate-agent-adapters.mjs --check",
    "agents:validate": "node scripts/governance/validate-agent-workspace.mjs",
    "docs:validate": "node scripts/governance/validate-docs.mjs",
    "delivery:validate": "node scripts/governance/validate-delivery.mjs",
    "traceability:validate": "node scripts/governance/validate-traceability.mjs",
    "qa:validate": "node scripts/governance/validate-qa.mjs",
    "release:validate": "node scripts/governance/validate-release.mjs",
    "governance:validate": "node scripts/governance/validate-governance.mjs",
    "test:governance": "node --test qa-automation/features/F000-development-harness/governance/*.test.mjs",
    "test:f001:s01:dev": "node --test qa-automation/features/F001-sinhala-english-production-voice/secure-baseline/*.test.mjs",
    "scaffold:feature": "node scripts/governance/scaffold.mjs feature",
    "scaffold:stage": "node scripts/governance/scaffold.mjs stage",
    "scaffold:task": "node scripts/governance/scaffold.mjs task",
    "qa:stage": "node scripts/qa/run-stage.mjs",
    "ci:verify": "npm run governance:validate && npm run test:governance && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google-cloud/speech": "^7.3.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@ricky0123/vad-web": "^0.0.30",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.1.6",
    "openai": "^4.104.0",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shadcn": "^4.0.3",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "werift": "^0.22.9",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
